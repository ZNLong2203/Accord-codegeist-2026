#!/usr/bin/env bash
set -euo pipefail
subject=$(head -n 1 "$1")
case "$subject" in Merge*|Revert*|fixup!*|squash!*) exit 0 ;; esac
if ! printf '%s' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'; then
  echo 'Use Conventional Commits: type(scope): description' >&2
  exit 1
fi
if [ ${#subject} -gt 72 ]; then
  echo 'Keep the commit subject at or below 72 characters.' >&2
  exit 1
fi
