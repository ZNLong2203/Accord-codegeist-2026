{
  "name": "accord-decision-drift",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed decision drift for Jira releases and Confluence decisions",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build && npm run manifest:check",
    "manifest:check": "node scripts/validate-manifest.cjs",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write src tests docs scripts README.md AGENTS.md manifest.yml '*.json' '*.ts'",
    "format:check": "prettier --check src tests docs scripts README.md AGENTS.md manifest.yml '*.json' '*.ts'",
    "forge": "forge",
    "forge:lint": "forge lint",
    "setup:hooks": "git config core.hooksPath scripts/hooks"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@forge/api": "8.4.0",
    "@forge/bridge": "7.2.1",
    "@forge/resolver": "2.0.2",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@forge/cli": "15.0.0",
    "@forge/manifest": "13.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "node": "22.23.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
