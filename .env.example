# Optional, local demo only (`npm run dev`). Copy to .env, which is gitignored.
# With a key, "Draft commitments" and "What does this change mean?" in the standalone
# demo call Gemini instead of showing prepared answers. The key is read by the Vite
# dev server only: it never reaches the browser bundle, the build or the Forge app.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# The Forge app uses Forge LLM (Atlassian-hosted Claude) and needs no key.
# Forge CLI login and managed identity need no .env values either.
FORGE_EMAIL=
FORGE_API_TOKEN=
